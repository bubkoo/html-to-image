{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "vitest.browser.config.mts",
    "playwright.config.ts",
    "test/browser-unit/**/*.ts",
    "test/browser/**/*.ts",
    "test/spec/**/*.ts"
  ]
}
