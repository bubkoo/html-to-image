{
  "name": "html-to-image",
  "version": "1.11.13",
  "packageManager": "pnpm@10.34.9",
  "description": "Generates an image from a DOM node using HTML5 canvas and SVG.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./*": "./*"
  },
  "unpkg": "dist/html-to-image.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist",
    "es",
    "lib",
    "src"
  ],
  "keywords": [
    "screenshot",
    "capture",
    "canvas",
    "html",
    "dom",
    "image",
    "vector",
    "svg"
  ],
  "scripts": {
    "lint": "eslint 'src/**/*.{js,ts}?(x)' --fix",
    "lint:check": "eslint 'src/**/*.{js,ts}?(x)' vitest.browser.config.mts playwright.config.ts 'test/browser-unit/**/*.ts' 'test/browser/**/*.ts' 'test/browser/**/*.mjs' 'test/spec/**/*.ts' rollup.config.js eslint.config.mjs commitlint.config.cjs 'scripts/*.{js,mjs,cjs}'",
    "clean": "node scripts/clean.mjs",
    "build:esm": "pnpm run build:esm:tsc && pnpm run build:esm:metadata",
    "build:esm:tsc": "tsc --module esnext --target es2017 --outDir ./es",
    "build:esm:metadata": "node scripts/mark-esm.mjs",
    "build:cjs": "tsc --module commonjs --target es5 --outDir ./lib",
    "build:umd": "rollup -c --bundleConfigAsCjs",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:cjs && pnpm run build:umd",
    "test:package": "node scripts/check-package.mjs",
    "test:browser:types": "tsc --project tsconfig.browser-tests.json",
    "test:browser:source": "vitest run --config vitest.browser.config.mts",
    "test:browser:regression": "TEST_SUITE=regression TEST_BROWSER=chromium vitest run --config vitest.browser.config.mts",
    "test:coverage": "TEST_SUITE=coverage TEST_BROWSER=chromium vitest run --config vitest.browser.config.mts --coverage",
    "test:browser:package": "playwright test --config playwright.config.ts",
    "test:browser": "pnpm run lint:check && pnpm run build && pnpm run test:browser:types && pnpm run test && pnpm run test:package && pnpm run test:browser:package",
    "test": "pnpm run test:coverage && pnpm run test:browser:source",
    "test:watch": "TEST_SUITE=coverage TEST_BROWSER=chromium vitest --config vitest.browser.config.mts",
    "prepare": "node scripts/prepare.mjs"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.{ts,mts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "release": {
    "extends": "@bubkoo/semantic-release-config"
  },
  "license": "MIT",
  "author": {
    "name": "bubkooo",
    "email": "bubkoo.wy@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bubkoo/html-to-image.git"
  },
  "bugs": {
    "url": "https://github.com/bubkoo/html-to-image/issues"
  },
  "homepage": "https://github.com/bubkoo/html-to-image#readme",
  "devDependencies": {
    "@bubkoo/semantic-release-config": "1.6.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "1.64.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pixelmatch": "^8.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "rollup": "^4.67.4",
    "tslib": "^2.9.1",
    "typescript": "~5.9.3",
    "typescript-compat": "npm:typescript@4.9.5",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
